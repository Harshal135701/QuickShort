<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuickShort | Dashboard</title>

    <link rel="stylesheet" href="/stylesheets/dashboard.css">
</head>

<body>

<!-- ===== NAVBAR ===== -->
<nav class="navbar">
    <h1 class="logo">🔗 QuickShort</h1>

    <form action="/logout" method="post">
        <button class="logout-btn">Logout</button>
    </form>
</nav>


<!-- ===== MAIN CONTENT ===== -->
<div class="container">

    <!-- CREATE SHORT URL -->
    <div class="card create-card">
        <h2>Create Short URL</h2>

        <form action="/shortUrlHomePage" method="post" class="url-form">
            <input type="text" name="url" placeholder="Enter your long URL here..." required>
            <button type="submit">Shorten</button>
        </form>
    </div>


    <!-- URL TABLE -->
    <% if(urls.length > 0) { %>

    <div class="card table-card">
        <h2>Your Links</h2>

        <table>
            <thead>
                <tr>
                    <th>Short URL</th>
                    <th>Original URL</th>
                    <th>Visits</th>
                    <th>Created At</th>
                </tr>
            </thead>

            <tbody>
                <% urls.forEach((url)=> { %>
                    <tr>
                        <td>
                            <a href="/<%= url.shorturl %>" target="_blank">
                                <%= url.shorturl %>
                            </a>
                        </td>

                        <td class="truncate">
                            <%= url.redirect %>
                        </td>

                        <td>
                            <%= url.visited.length %>
                        </td>

                        <td>
                            <%= new Date(url.createdAt).toLocaleString() %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>

        </table>
    </div>

    <% } %>

</div>

</body>
</html>
